MLFLOW_SQLALCHEMYSTORE_MAX_OVERFLOW=40
MLFLOW_SQLALCHEMYSTORE_POOL_TIMEOUT=120
MLFLOW_SQLALCHEMYSTORE_POOL_RECYCLE=1800
RAY_TRAIN_WORKER_GROUP_START_TIMEOUT_S=7200
TORCHINDUCTOR_FX_GRAPH_CACHE=1
TORCHINDUCTOR_AUTOGRAD_CACHE=1
AWS_ACCESS_KEY_ID=example-access-key-id
AWS_EC2_METADATA_DISABLED=true
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=example-secret-access-key
HEAD_LOCAL_IP=203.0.113.10
KAGGLEHUB_CACHE=/work/user/noboom/experiment_data/datasets
KAGGLE_API_TOKEN=example-kaggle-token
MLFLOW_S3_ENDPOINT_URL=http://203.0.113.10:8333
MLFLOW_STORAGE_URI=postgresql+psycopg://noboom:example-password@203.0.113.10:5432/mlflow_db
MLFLOW_TRACKING_URI=http://203.0.113.10:5000
MLFLOW_UI_LOCAL_PORT=5001
NOBOOM_DOCKER_WORKDIR=/work/user/noboom
NOBOOM_DOCKER_WORKDIR_HOST=/work/user/noboom
NOBOOM_MAPPED_STORAGE=/work/user/noboom/experiment_data
NOBOOM_ROOT_DIR=/work/user/noboom
NOBOOM_SKIP_COMPOSE_UP=1
NOBOOM_SKIP_DOCKER_CLEANUP=1
NOBOOM_STORAGE=/work/user/noboom/experiment_data
NOBOOM_USE_DOCKER=0
NOBOOM_USE_SEAWEED=1
NOBOOM_WORKER_DEBUG=None
NUMBA_CACHE_DIR=/work/user/noboom/.numba
OPTUNA_STORAGE_URI=postgresql+psycopg://noboom:example-password@203.0.113.10:5432/optuna_db
POSTGRES_PASSWORD=example-password
RAY_AUTH_MODE=token
RAY_enable_autoscaler_v2=0
S3_ENDPOINT_URL=http://203.0.113.10:8333
SEAFILE_PASS=example-seafile-password
SEAFILE_ROOT_PATH=example-results-root
SEAFILE_USERNAME=example-user
