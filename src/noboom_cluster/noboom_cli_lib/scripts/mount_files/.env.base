# Template only. Runtime launches render this file into a temporary bundle.
# Do not commit generated credentials, host IPs, private paths, or service URLs.
POSTGRES_USER=noboom
NOBOOM_PERSISTENT=1
NOBOOM_SKIP_SEAFILE_SETUP=0
NOBOOM_S3_BUCKET=example-s3-bucket
NOBOOM_S3_PREFIX=experiment_data
RAY_record_task_actor_creation_sites=true
RAY_process_group_cleanup_enabled=true
